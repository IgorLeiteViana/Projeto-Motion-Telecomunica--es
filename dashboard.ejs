<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciador Financeiro</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

    <aside class="sidebar">
        <div class="menu-icon"></div>
        <nav>
            <ul>
                <li class="menu-link active" data-target="tela-principal">Tela Principal</li>
                <li class="menu-link" data-target="aba-adicao">Adição Despesa/Entrada</li>
                <li class="menu-link" data-target="aba-relatorios">Relatórios</li>
                <li class="menu-link" data-target="aba-graficos">Gráficos</li>
            </ul>
        </nav>
    </aside>

    <main class="content">
        <section id="tela-principal" class="tab-content active">
            <header class="top-bar-principal">
                <div class="select-mes-container">
                    <select class="select-mes-estilizado"></select>
                </div>
            </header>
            
            <section class="dashboard-cards">
                <div class="card red"><span>DESPESAS TOTAIS</span><h2>R$ 0,00</h2></div>
                <div class="card green"><span>ENTRADAS TOTAIS</span><h2>R$ 0,00</h2></div>
                <div class="card white"><span>SALDO DISPONÍVEL</span><h2>R$ 0,00</h2></div>
                <div class="card white"><span>LUCRO TOTAL</span><h2>R$ 0,00</h2></div>
                <div class="card gray"><span>CONTAS A PAGAR</span><h2>R$ 0,00</h2></div>
                <div class="card gray"><span>CONTAS PAGAS</span><h2>R$ 0,00</h2></div>
            </section>

            <section class="chart-container-principal">
                <canvas id="lucroChartPrincipal"></canvas>
            </section>
        </section>

        <section id="aba-adicao" class="tab-content">
            <div class="header-adicao">
                <h1>ADICIONAR</h1>
                <button id="btn-abrir-modal" class="btn-plus-novo">+</button>
            </div>
            <div id="lista-vazia" class="empty-state-central">
                <p>NÃO EXISTE DESPESA OU ENTRADA 🍃</p>
            </div>
            <div id="lista-itens" class="items-container"></div>
        </section>

        <section id="aba-relatorios" class="tab-content">
            <header class="header-relatorios">
                <div class="select-mes-container">
                    <select class="select-mes-estilizado"></select>
                </div>
            </header>
            <div class="grid-relatorios">
                <div class="col-relatorio">
                    <div class="card-relatorio red"><span>DESPESA FIXA</span><h2>R$ 0,00</h2></div>
                    <div class="card-relatorio red"><span>DESPESA VARIÁVEL</span><h2>R$ 0,00</h2></div>
                    <div class="card-relatorio red"><span>DESPESA TOTAL</span><h2>R$ 0,00</h2></div>
                </div>
                <div class="col-relatorio">
                    <div class="card-relatorio green"><span>ENTRADA FIXA</span><h2>R$ 0,00</h2></div>
                    <div class="card-relatorio green"><span>ENTRADA VARIÁVEL</span><h2>R$ 0,00</h2></div>
                    <div class="card-relatorio green"><span>ENTRADA TOTAL</span><h2>R$ 0,00</h2></div>
                </div>
                <div class="col-relatorio">
                    <div class="card-relatorio-destaque white"><span>SALDO</span><h2>R$ 0,00</h2></div>
                    <div class="container-lucro">
                        <div class="lucro-indicadores">
                        </div>
                        <div class="card-relatorio-destaque white"><span>LUCRO</span><h2>R$ 0,00</h2></div>
                    </div>
                </div>
            </div>
        </section>

        <section id="aba-graficos" class="tab-content">
            <div class="grid-graficos-2x2">
                <div class="grafico-item border-red">
                    <h3 class="titulo-grafico color-red">DESPESAS</h3>
                    <div class="canvas-wrapper"><canvas id="chartDespesas"></canvas></div>
                </div>
                <div class="grafico-item border-green">
                    <h3 class="titulo-grafico color-green">ENTRADAS</h3>
                    <div class="canvas-wrapper"><canvas id="chartEntradas"></canvas></div>
                </div>
                <div class="grafico-item border-yellow">
                    <h3 class="titulo-grafico color-yellow">LUCRO</h3>
                    <div class="canvas-wrapper"><canvas id="chartLucro"></canvas></div>
                </div>
                <div class="grafico-item border-blue">
                    <h3 class="titulo-grafico color-blue">SALDO</h3>
                    <div class="canvas-wrapper"><canvas id="chartSaldo"></canvas></div>
                </div>
            </div>
        </section>

        <div id="modal-formulario" class="modal">
            <div class="modal-content">
                <h3>NOVO REGISTRO</h3>
                <input type="number" id="form-valor" placeholder="0,00" step="0.01">
                <input type="text" id="form-nome" placeholder="NOME">
                <input type="text" id="form-descricao" placeholder="DESCRIÇÃO">
                <div class="form-row">
                    <select id="form-tipo">
                        <option value="entrada">ENTRADA</option>
                        <option value="despesa">DESPESA</option>
                    </select>
                    <select id="form-categoria">
                        <option value="fixa">FIXA</option>
                        <option value="variavel">VARIÁVEL</option>
                    </select>
                </div>
                <div class="modal-buttons">
                    <button id="btn-salvar">SALVAR</button>
                    <button id="btn-cancelar">CANCELAR</button>
                </div>
            </div>
        </div>
    </main>

    <script src="script.js"></script>
</body>
</html>