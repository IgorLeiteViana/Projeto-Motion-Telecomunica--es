<section id="aba-adicao" class="tab-content">
    <div class="header-adicao">
        <h1>ADICIONAR</h1>
        <button id="btn-abrir-modal" class="btn-plus-novo">+</button>
    </div>
    <div id="lista-vazia" class="empty-state-central">
        <p>NÃO EXISTE DESPESA OU ENTRADA 🍃</p>
    </div>
    <div id="lista-itens" class="items-container"></div>
</section>

<div id="modal-formulario" class="modal">
    <div class="modal-content">
        <h3>NOVO REGISTRO</h3>
        <input type="number" id="form-valor" placeholder="0,00" step="0.01">
        <input type="text" id="form-nome" placeholder="NOME">
        <input type="text" id="form-descricao" placeholder="DESCRIÇÃO">
        <div class="form-row">
            <select id="form-tipo">
                <option value="entrada">ENTRADA</option>
                <option value="despesa">DESPESA</option>
            </select>
            <select id="form-categoria">
                <option value="fixa">FIXA</option>
                <option value="variavel">VARIÁVEL</option>
            </select>
        </div>
        <div class="form-row">
            <input type="date" id="form-data-vencimento" placeholder="Data de Vencimento">
            <input type="date" id="form-data-pagamento" placeholder="Data de Pagamento">
        </div>
        <div class="form-row">
            <input type="date" id="form-data-ganho" placeholder="Data do Ganho">
            <select id="form-recorrencia">
                <option value="">Recorrência</option>
                <option value="Mensal">Mensal</option>
                <option value="Semanal">Semanal</option>
                <option value="Anual">Anual</option>
            </select>
        </div>
        <div class="modal-buttons">
            <button id="btn-salvar">SALVAR</button>
            <button id="btn-cancelar">CANCELAR</button>
        </div>
        </div>
    </div>
</div>

<div id="modal-saldo-inicial" class="modal">
    <div class="modal-content">
        <h3>Saldo Inicial</h3>
        <p>Informe o saldo inicial antes de usar o dashboard.</p>
        <input type="number" id="form-saldo-inicial" placeholder="0,00" step="0.01">
        <div class="modal-buttons">
            <button id="btn-salvar-saldo">Salvar Saldo</button>
        </div>
    </div>
</div>
