<section id="aba-relatorios" class="tab-content">
    <header class="header-relatorios">
        <div class="select-mes-container">
            <input type="month" class="select-month-input">
            <select class="select-mes-estilizado"></select>
        </div>
    </header>
    <div class="grid-relatorios">
        <div class="col-relatorio">
            <div class="card-relatorio red"><span>DESPESA FIXA</span><h2>R$ 0,00</h2></div>
            <div class="card-relatorio red"><span>DESPESA VARIÁVEL</span><h2>R$ 0,00</h2></div>
            <div class="card-relatorio red"><span>DESPESA TOTAL</span><h2>R$ 0,00</h2></div>
        </div>
        <div class="col-relatorio">
            <div class="card-relatorio green"><span>ENTRADA FIXA</span><h2>R$ 0,00</h2></div>
            <div class="card-relatorio green"><span>ENTRADA VARIÁVEL</span><h2>R$ 0,00</h2></div>
            <div class="card-relatorio green"><span>ENTRADA TOTAL</span><h2>R$ 0,00</h2></div>
        </div>
        <div class="col-relatorio">
            <div class="card-relatorio-destaque white"><span>SALDO</span><h2>R$ 0,00</h2></div>
            <div class="container-lucro">
                <div class="lucro-indicadores"></div>
                <div class="card-relatorio-destaque white"><span>LUCRO</span><h2>R$ 0,00</h2></div>
            </div>
        </div>
    </div>
    <div class="comparativo-container">
        <div class="comparativo-card">
            <h4>Variação Despesas</h4>
            <p class="comparativo-despesas">0%</p>
        </div>
        <div class="comparativo-card">
            <h4>Variação Entradas</h4>
            <p class="comparativo-entradas">0%</p>
        </div>
        <div class="comparativo-card">
            <h4>Variação Saldo</h4>
            <p class="comparativo-saldo">0%</p>
        </div>
        <div class="comparativo-card">
            <h4>Variação Lucro</h4>
            <p class="comparativo-lucro">0%</p>
        </div>
    </div>
    <div class="visao-mensal-container">
        <div class="visao-mensal-card">
            <span>Maior Despesa</span>
            <h2 id="maior-despesa">R$ 0,00</h2>
        </div>
        <div class="visao-mensal-card">
            <span>Projeção Próximo Mês</span>
            <h2 id="projecao-proximo-mes">R$ 0,00</h2>
        </div>
    </div>
    <div class="visao-dia-container">
        <div class="visao-dia-header">
            <input type="date" id="dia-selecionado">
            <button id="btn-filtrar-dia" class="btn-export">Ver Dia</button>
        </div>
        <div class="visao-dia-result">
            <div class="card-relatorio white"><span>SALDO DO DIA</span><h2 id="saldo-dia">R$ 0,00</h2></div>
            <div class="card-relatorio white"><span>LANÇAMENTOS DO DIA</span><h2 id="total-dia">0</h2></div>
        </div>
        <div id="lista-dia" class="lista-dia"></div>
    </div>
</section>
